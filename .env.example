# -----------------------------------------------------------------------------
# CareOrbit (Guardian Oasis) — Production Environment Variables
# -----------------------------------------------------------------------------

# Application Host URL (e.g., Cloud Run URL or custom domain)
NEXT_PUBLIC_APP_URL=https://guardian-oasis-xyz-uc.a.run.app

# Node Environment ("production" enforces strict session secret & database requirements)
NODE_ENV=production
PORT=8080

# Iron Session Cookie Encryption Secret (Must be 32+ characters, required in production)
# Generate with: openssl rand -base64 32
IRON_SESSION_SECRET=guardian-oasis-production-encryption-secret-32-chars-min

# CareLoop Watchdog Authentication (Required for cron task escalation trigger)
# Generate with: openssl rand -hex 24
CRON_SECRET=careorbit-cron-watchdog-secret-32-chars-min

# Supabase PostgreSQL Database (Required for persistent production storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional direct PostgreSQL connection string
DATABASE_URL=postgres://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# Google Gemini API Key for MedSutra AI Vision Extraction
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Resend API Key for Automated Email Dispatch & CareLoop Reminders
# Obtain from Resend: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=careorbit@yourdomain.com
